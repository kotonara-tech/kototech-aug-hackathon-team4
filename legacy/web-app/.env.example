# このファイルを .env にコピーして値を埋めてください（.env は Git に入れないこと）

# Google Cloud Console > API とサービス > 認証情報 で作成した OAuth クライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# セッション Cookie の署名鍵。本番では必ずランダムな値に変える。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Android アプリが写真を保存する Google ドライブのフォルダ名
# 担当 A と一致させること（docs/担当A向け連携仕様.md 参照）
DRIVE_FOLDER_NAME=FarmCameraPOC

# 一覧で読み込む写真の最大枚数
MAX_PHOTOS=300
