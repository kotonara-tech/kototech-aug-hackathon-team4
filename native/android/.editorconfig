root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Android Studio のスタイルに合わせる。ktlint_official は多引数の関数シグネチャを
# 常に複数行へ展開するため、この規模のコードでは読みにくくなる。
ktlint_code_style = android_studio
max_line_length = 120

[*.{yml,yaml,json,xml}]
indent_size = 2
